 "items": {
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1793339159363-final-64c7e04.pdf": {
   "days": 5,
   "kind": "hábiles",
   "text": "Las solicitudes se dirigirán al Alcalde-Presidente del Ayuntamiento de Vega de Espinareda (León) y se presentarán en el plazo de cinco días hábiles, contados a partir del siguiente a aquel en que aparezca publicado el anuncio de la convocatoria en el Boletín Oficial de la Provincia de León.",
   "page": 4
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1793252757679-final-5424a2c9.pdf": {
   "days": 10,
   "kind": "hábiles",
   "text": "Las solicitudes se presentarán en el plazo de diez días hábiles contados desde el siguiente al de la publicación de la convocatoria en la sede electrónica, mediante el modelo del Anexo I, en el Registro General o por cualquiera de los medios del artículo 16.4 de la Ley 39/2015.",
   "page": 2
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1793252747882-final-76c4b07d.pdf": {
   "days": 20,
   "kind": "hábiles",
   "text": "La fecha de publicación del extracto en el B.O.E. abrirá el plazo, de 20 días hábiles, para la presentación de instancias.",
   "page": 1
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1793684753587-final-74ffa106.pdf": {
   "days": 5,
   "kind": "hábiles",
   "text": "Plazo Dada la necesidad urgente e inaplazable de cobertura del puesto, el plazo de presentación será de: Cinco días hábiles, contados a partir del siguiente a la publicación del anuncio de la convocatoria en el BOP de León.",
   "page": 3
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1793684747988-final-2bef5959.pdf": {
   "days": 20,
   "kind": "hábiles",
   "text": "La fecha de publicación del anuncio en el BOE abrirá el plazo, de 20 días hábiles, para la presentación de instancias.",
   "page": 2
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1793684743180-final-44fdef57.pdf": {
   "days": 20,
   "kind": "hábiles",
   "text": "La fecha de publicación del anuncio en el BOE abrirá el plazo, de 20 días hábiles, para la presentación de instancias.",
   "page": 2
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1793771150913-final-7b0edfc6.pdf": {
   "days": 10,
   "kind": "naturales",
   "text": "El plazo de presentación será de diez días naturales contados a partir del día siguiente al de la publicación del anuncio de la convocatoria en el Boletín Oficial de la Provincia de León (BOP), Cód.",
   "page": 3
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1794289557216-final-e63da54.pdf": {
   "days": 15,
   "kind": "hábiles",
   "text": "La fecha de publicación del extracto en BOE abrirá el plazo, de 15 días hábiles, para la presentación de instancias.",
   "page": 3
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1794375969813-final-5da911bd.pdf": {
   "days": 15,
   "kind": "hábiles",
   "text": "…referidas siempre a la fecha de expiración del plazo de presentación de instancias, se dirigirán a la Presidencia de la Corporación y se presentarán en el Registro General del Ayuntamiento, en el plazo de QUINCE DÍAS HÁBILES, contados a partir del siguiente al de la publicación del anuncio de la convocatoria en el…",
   "page": 4
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1795153554196-final-235699b5.pdf": {
   "days": 20,
   "kind": "hábiles",
   "text": "…electrónica del Ayuntamiento de La Robla, en el plazo de veinte días hábiles a contar desde el siguiente a la publicación de las Bases en el BOP, en el modelo establecido en el Anexo I (sólo se podrá solicitar un árbol por cada Junta Vecinal beneficiario), debiendo aportar, además: a) Declaración responsable de no…",
   "page": 3
  },
  "https://bop.dipuleon.es/export/sites/bop/.galleries/Documentos-Anuncios-en-PDF/firmado-1795153548857-final-785ccddf.pdf": {
   "days": 20,
   "kind": "hábiles",
   "text": "El plazo de veinte días hábiles para la presentación de solicitudes se computará a partir del día siguiente al de la publicación de dicho anuncio en el BOE.",
   "page": 2
  }
 },
